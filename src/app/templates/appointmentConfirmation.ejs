<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appointment Confirmation</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f1f5f9; padding: 40px 10px;">
        <tr>
            <td align="center">
                <!-- Main Container -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 580px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;">
                    <!-- Brand Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #059669 0%, #0284c7 100%); padding: 32px 24px; text-align: center;">
                            <div style="display: inline-block; background-color: rgba(255, 255, 255, 0.2); padding: 8px 16px; border-radius: 20px; margin-bottom: 12px;">
                                <span style="color: #ffffff; font-size: 14px; font-weight: 600; letter-spacing: 0.5px;">🏥 PH HEALTHCARE SYSTEM</span>
                            </div>
                            <h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.5px;">Appointment Confirmed</h1>
                        </td>
                    </tr>

                    <!-- Body Content -->
                    <tr>
                        <td style="padding: 36px 32px;">
                            <p style="margin: 0 0 16px 0; font-size: 16px; color: #334155; line-height: 24px;">
                                Hello <%= patientName %>,
                            </p>
                            <p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 24px;">
                                Your medical consultation appointment has been scheduled successfully. Here are the details of your upcoming appointment:
                            </p>

                            <!-- Details Table Card -->
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 24px;">
                                <tr>
                                    <td style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
                                        <span style="font-size: 13px; color: #64748b; display: block;">Doctor</span>
                                        <strong style="font-size: 16px; color: #1e293b;"><%= doctorName %></strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
                                        <span style="font-size: 13px; color: #64748b; display: block;">Date & Time</span>
                                        <strong style="font-size: 15px; color: #1e293b;"><%= appointmentDate %> (<%= startTime %> - <%= endTime %>)</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
                                        <span style="font-size: 13px; color: #64748b; display: block;">Payment Status</span>
                                        <strong style="font-size: 14px; color: <%= paymentStatus === 'PAID' ? '#059669' : '#d97706' %>;">
                                            <%= paymentStatus %>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 16px 20px;">
                                        <span style="font-size: 13px; color: #64748b; display: block;">Video Consultation ID</span>
                                        <span style="font-size: 13px; font-family: monospace; color: #0284c7;"><%= videoCallingId %></span>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin: 0; font-size: 14px; color: #64748b; line-height: 22px;">
                                Please ensure you join the online portal 5 minutes prior to the scheduled consultation time.
                            </p>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding: 0 32px;">
                            <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0;">
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 32px; background-color: #f8fafc; text-align: center;">
                            <p style="margin: 0 0 8px 0; font-size: 13px; color: #64748b;">
                                Need to reschedule or have questions? Contact us at <a href="mailto:support@phhealthcare.com" style="color: #0284c7; text-decoration: none; font-weight: 500;">support@phhealthcare.com</a>
                            </p>
                            <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                                &copy; <%= new Date().getFullYear() %> PH Healthcare Management System. All rights reserved.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
